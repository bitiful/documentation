{
  "theme": "mint",
  "name": "缤纷云文档",
  "colors": {
    "primary": "#0D9373",
    "light": "#04d39a",
    "dark": "#0D9373"
  },
  "favicon": "/favicon-docs.svg",
  "logo": {
    "light": "https://files.bitiful.com/images/bitiful-Docs-Logo-V2-light.svg",
    "dark": "https://files.bitiful.com/images/bitiful-Docs-Logo-V2-dark.svg"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "image": "https://bitiful-contents.s3.bitiful.net/images/bitiful-docs-blur-bg.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "官网",
        "href": "https://www.bitiful.com"
      },
      {
        "label": "更新记录",
        "href": "/changelog/overview"
      }
    ],
    "primary": {
      "type": "button",
      "label": "控制台",
      "href": "https://console.bitiful.com"
    }
  },
  "footer": {
    "socials": {
      "website": "https://www.bitiful.com/"
    }
  },
  "redirects": [
    {
      "source": "/docs/:slug*",
      "destination": "/:slug*"
    },
    {
      "source": "/BitifulS4/:slug*",
      "destination": "/bitiful-s4/:slug*"
    },
    {
      "source": "/bitiful-s4/what-is-bitiful-s4",
      "destination": "/bitiful-s4/intro"
    },
    {
      "source": "/intro",
      "destination": "/bitiful-s4/intro"
    },
    {
      "source": "/sdk",
      "destination": "/developer/sdk/intro"
    },
    {
      "source": "/sdk/:slug*",
      "destination": "/developer/sdk/:slug*"
    },
    {
      "source": "/category/:slug*",
      "destination": "/bitiful-s4/intro"
    }
  ],
  "navigation": {
